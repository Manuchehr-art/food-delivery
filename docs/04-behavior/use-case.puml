@startuml use-case
left to right direction
title food-delivery: Диаграмма вариантов использования

actor "Клиент\n(client)" as Client
actor "Менеджер/Оператор\n(manager)" as Manager
actor "Курьер\ncourier)" as Courier
actor "Администратор\n(admin)" as Admin

rectangle "food-delivery" {
  usecase "Войти в систему" as UC1
  usecase "Выбрать блюда и оформить заказ" as UC2
  usecase "Проверить зону доставки и мин. сумму" as UC3
  usecase "Отменить заказ" as UC4
  usecase "Отследить статус заказа" as UC5
  usecase "Оставить отзыв о заказе" as UC6
  usecase "Подтвердить заказ и назначить курьера" as UC7
  usecase "Изменить статус доставки" as UC8
  usecase "Вести справочник блюд и ресторанов" as UC9
  usecase "Сформировать отчёт за смену" as UC10
}

' Связи акторов с вариантами использования
Client --> UC1
Client --> UC2
Client --> UC5
Client --> UC6

Manager --> UC1
Manager --> UC7
Manager --> UC10

Courier --> UC1
Courier --> UC8

Admin --> UC1
Admin --> UC9
Admin --> UC10

' Отношения include и extend
UC2 ..> UC3 : <<include>>
UC4 .> UC2 : <<extend>>
@enduml